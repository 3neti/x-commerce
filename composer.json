{
  "name": "3neti/x-commerce",
  "description": "Commercial architecture and knowledge system for packaging, pricing, licensing, metering, and sustaining outcomes delivered through the x-change ecosystem.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "commerce",
    "commercial-architecture",
    "pricing",
    "licensing",
    "metering",
    "x-change"
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "laravel/pint": "^1.18",
    "phpunit/phpunit": "^10.5"
  },
  "scripts": {
    "test": "phpunit",
    "format": "pint",
    "format:check": "pint --test"
  },
  "autoload": {
    "psr-4": {
      "LBHurtado\\XCommerce\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LBHurtado\\XCommerce\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "LBHurtado\\XCommerce\\XCommerceServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  }
}
